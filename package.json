{
  "name": "barr.-henry-law-council",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "api": "node --env-file-if-exists=.env --env-file-if-exists=.env.local server/server.mjs",
    "dev:full": "concurrently \"npm run api\" \"npm run dev\"",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "check:env": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/check-env.mjs",
    "test": "node --test server/*.test.mjs"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0"
  }
}
